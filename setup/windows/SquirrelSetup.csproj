<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Building a Windows-targeted WPF app from macOS/Linux. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <AssemblyName>SquirrelSetup</AssemblyName>
    <RootNamespace>SquirrelSetup</RootNamespace>
    <ApplicationIcon>Resources\Setup.ico</ApplicationIcon>
    <Product>Squirrel 鼠鬚管安装程序</Product>
    <AssemblyTitle>Squirrel Setup (Windows)</AssemblyTitle>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Company>Rime / Squirrel</Company>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\default.custom.yaml" LogicalName="SquirrelSetup.Resources.default.custom.yaml" />
    <EmbeddedResource Include="Resources\presets.json" LogicalName="SquirrelSetup.Resources.presets.json" />
  </ItemGroup>

</Project>
