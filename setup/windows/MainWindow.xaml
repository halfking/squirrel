<Window x:Class="SquirrelSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Squirrel 鼠鬚管安装程序 (Windows)"
        Width="880" Height="660" MinWidth="820" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#FAFAFA">

  <Grid Margin="20,18,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="Squirrel 鼠鬚管 安装程序"
                 FontSize="24" FontWeight="SemiBold" Foreground="#1A1A1A" />
      <TextBlock x:Name="Subtitle"
                 FontSize="12" Foreground="#6B6B6B" Margin="0,4,0,0"
                 Text="为 macOS / Windows / Linux 提供同一套 Rime 配置 · Windows 版" />
    </StackPanel>

    <!-- Steps -->
    <StackPanel x:Name="StepPanel" Grid.Row="1" Margin="0,18,0,10" />

    <!-- Log -->
    <GroupBox Grid.Row="2" Header="安装日志 / Log" Padding="6">
      <TextBox x:Name="LogBox"
               IsReadOnly="True" AcceptsReturn="True"
               FontFamily="Cascadia Mono, Consolas, Courier New"
               FontSize="12"
               Background="White"
               BorderThickness="0"
               TextWrapping="NoWrap"
               VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto" />
    </GroupBox>

    <!-- Progress + status -->
    <StackPanel Grid.Row="3" Margin="0,12,0,0">
      <ProgressBar x:Name="Progress" Height="6" Minimum="0" Maximum="6" Value="0" />
      <TextBlock x:Name="StatusText" Margin="0,8,0,0" FontSize="12" Foreground="#6B6B6B" />
    </StackPanel>

    <!-- Buttons -->
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal">
        <Button x:Name="InstallButton" Content="开始安装" Width="110" Height="32"
                FontSize="14" FontWeight="SemiBold" Click="OnInstallClick" />
        <Button x:Name="DetectButton" Content="重新检测" Width="100" Height="32"
                Margin="10,0,0,0" FontSize="13" Click="OnDetectClick" />
        <Button x:Name="RevealButton" Content="打开配置目录" Width="120" Height="32"
                Margin="10,0,0,0" FontSize="13" Click="OnRevealClick" />
      </StackPanel>
      <Button x:Name="CloseButton" Content="退出" Width="80" Height="32"
              HorizontalAlignment="Right" FontSize="13" Click="OnCloseClick" />
    </Grid>
  </Grid>
</Window>
